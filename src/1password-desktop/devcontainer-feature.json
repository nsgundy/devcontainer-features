{
  "id": "1password-desktop",
  "version": "0.2.1",
  "name": "1Password desktop integration (experimental)",
  "documentationURL": "https://github.com/nsgundy/devcontainer-features/tree/main/src/1password-desktop",
  "licenseURL": "https://github.com/nsgundy/devcontainer-features/blob/main/LICENSE",
  "description": "Official apt CLI and canonical single-socket integration for trusted native-Linux devcontainers. Requires Python 3 (installed).",
  "options": {
    "hostCliGid": {"type": "string", "default": "", "description": "Required numeric group from host stat -c %g /usr/bin/op"}
  },
  "mounts": [{"type": "bind", "source": "${localEnv:XDG_RUNTIME_DIR}/1Password-BrowserSupport.sock", "target": "${localEnv:XDG_RUNTIME_DIR}/1Password-BrowserSupport.sock"}],
  "containerEnv": {"OP_BIOMETRIC_UNLOCK_ENABLED": "true"},
  "postStartCommand": "/usr/local/share/1password-desktop/configure-runtime.py",
  "installsAfter": ["ghcr.io/devcontainers/features/common-utils"]
}
